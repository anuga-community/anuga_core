#!/bin/bash
#PBS -N anuga_a100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=256GB
#PBS -l jobfs=200GB
#PBS -l storage=gdata/bm55+scratch/bm55
#PBS -q dgxa100
#PBS -P bm55
#PBS -l walltime=01:30:00
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/bm55/jlv900/dev/anuga_core/standalone/build/a100/pbs.log

# A100-80 point on the model: gates, structured sweep to the predicted
# ~166M ceiling, basin ordering runs, and the 11k-km^2 spec mesh if present.
set -x
ROOT=/scratch/bm55/jlv900/dev/anuga_core/standalone
OUT=$ROOT/build/a100
mkdir -p "$OUT"
cd "$ROOT"
source ./env.sh
nvidia-smi --query-gpu=name,compute_cap,memory.total --format=csv | tee "$OUT/gpu.txt"

# Build on node-local jobfs: concurrent jobs on different GPU archs must
# never share a binary or object dir on the global filesystem.
BENCH=$PBS_JOBFS/bench_gpu
make --no-print-directory CONFIG=gpu OBJDIR=$PBS_JOBFS/obj BIN=$BENCH build 2>&1 | tail -1

{
  "$BENCH" --nx 300 --ny 300 --steps 40 --case lake --scheme ader2 --flux scatter \
      | grep -E "volume|momentum"
  [ -f build/basin_still.msh ] && \
  "$BENCH" --mesh build/basin_still.msh --steps 40 --scheme ader2 --flux scatter \
      | grep -E "volume|momentum"
} > "$OUT/gates.txt" 2>&1

# Structured sweep bracketing the predicted (79.6-0.3)/512B ~ 166.3M ceiling
./tools/scaling_sweep.sh --bin "$BENCH" --steps 15 --warmup 3 --csv "$OUT/scaling.csv" \
    500 1000 2000 3200 4000 5000 5600 6000 6300 6400 6430 6450 6500 \
    -- --scheme ader2 --flux scatter > "$OUT/sweep.txt" 2>&1

# Basin ordering (as-meshed vs morton), whatever sizes exist
for msh in basin_2m basin_8m basin_20m; do
  f=build/$msh.msh; [ -f "$f" ] || continue
  { for o in row morton; do
      printf "%-8s " $o
      "$BENCH" --mesh "$f" --steps 25 --warmup 4 \
          --scheme ader2 --flux scatter --order $o | grep "ms/step"
    done
  } > "$OUT/$msh.txt" 2>&1
done

# The spec run, if the 11k-km^2 mesh has been generated by now
if [ -f build/basin_spec11k.msh ]; then
  for o in row morton; do
    "$BENCH" --mesh build/basin_spec11k.msh --steps 40 --warmup 6 \
        --scheme ader2 --flux scatter --order $o > "$OUT/spec_$o.txt" 2>&1
    rate=$(grep "sim rate" "$OUT/spec_$o.txt" | grep -o "[0-9.]*" | head -1)
    echo "$o: sim rate $rate -> $(echo "scale=2; 24/$rate/1" | bc) h/sim-day (1x A100-80)" \
        | tee -a "$OUT/HEADLINE.txt"
  done
fi

echo done | tee "$OUT/DONE"
